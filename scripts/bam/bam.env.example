# Copy to bam.env (ignored by Git) and edit for your host.
BAM_PYTHON=/absolute/path/to/venv/bin/python
BAM_OUTPUT=/absolute/path/to/public/static/bam
BAM_CACHE=/absolute/path/to/private/bam-cache
# 0 = verify all available logs; changed content triggers regeneration.
BAM_LIMIT=0
# Prefer local collector directories on the operational host:
# BAM_FINPE_SOURCE=/absolute/path/cron_scripts/logs/smna-finpe/model
# BAM_FNCEP_SOURCE=/absolute/path/cron_scripts/logs/smna-fncep/model
# If omitted, the provided dataserver URLs are used.
